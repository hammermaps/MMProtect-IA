{
  "InstanceAgent": {
    "DataDirectory": "/var/lib/mmprotect-agent",
    "PortRangeStart": 18000,
    "PortRangeEnd": 18999,
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "DockerTimeoutSeconds": 15,
    "NginxConfigurationDirectory": "/etc/nginx/mmprotect.d",
    "NginxTemplateVersion": 1,
    "LetsEncryptWebRoot": "/var/www/letsencrypt"
  }
}
