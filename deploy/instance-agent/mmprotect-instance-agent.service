[Unit]
Description=MMProtect Instanz-Agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=exec
User=mmprotect-agent
Group=mmprotect-agent
WorkingDirectory=/opt/mmprotect-instance-agent
EnvironmentFile=/etc/mmprotect-instance-agent/environment
ExecStart=/usr/bin/dotnet /opt/mmprotect-instance-agent/MmProtect.InstanceAgent.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mmprotect-agent /etc/nginx/mmprotect.d /var/www/letsencrypt /etc/letsencrypt

[Install]
WantedBy=multi-user.target
